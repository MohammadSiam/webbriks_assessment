# Used by `docker compose up --build` (or any subset of the infra/api/web
# compose files) run from the repo root.

# --- infra/docker-compose.db.yml ---
POSTGRES_USER=webbriks
POSTGRES_PASSWORD=webbriks
POSTGRES_DB=webbriks_kanban
POSTGRES_PORT=5433

# --- apps/api/docker-compose.yml ---
# Required, no default: generate one with `openssl rand -base64 32`.
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGIN=http://localhost:3000

# --- apps/web/docker-compose.yml ---
# Baked into the browser bundle at image build time (see apps/web/Dockerfile).
NEXT_PUBLIC_API_URL=http://localhost:4000
